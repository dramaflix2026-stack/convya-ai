# Configure estes valores em Railway > convya-ai > Variables.
# NUNCA publique valores reais no GitHub ou no chat.
CONVYA_WA_ADMIN_KEY=
CONVYA_TEST_PHONE=
# Opcional: pasta privada em volume da Railway (não comitar arquivos).
CONVYA_WA_AUTH_DIR=

# Vendedor IA da PageNova (depois da aprovação do site)
OPENAI_API_KEY=
CONVYA_AGENT_MODEL=gpt-4.1-mini
PAGENOVA_CONVYA_HANDOFF_SECRET=

# Busca de empresas da V16: desligada no piloto WhatsApp
GOOGLE_MAPS_API_KEY=
CONVYA_SEARCH_ACCESS_TOKEN=
